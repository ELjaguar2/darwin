{
  "name": "darwin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Darwin : agents IA qui gagnent leur vie, paient leur cerveau, se reproduisent et meurent (NEAR testnet).",
  "license": "MIT",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "start": "tsx backend/main.ts",
    "start:mock": "cross-env DARWIN_MODE=mock DARWIN_CHAIN= DARWIN_BRAIN= tsx backend/main.ts",
    "start:demo": "cross-env DARWIN_PRESET=demo tsx backend/main.ts",
    "start:testnet": "cross-env DARWIN_MODE=testnet tsx backend/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "contracts:build": "cd contracts/darwin && cargo near build non-reproducible-wasm",
    "scan-secrets": "node scripts/scan-secrets.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "hono": "4.13.17",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "near-api-js": "7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "cross-env": "^7.0.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
