# Darwin - variables d'environnement. AUCUNE valeur secrete ici. Copier vers .env (ignore par git).
# Sans aucun .env : mode mock complet (chaine + IA simulees), aucune cle necessaire.
# Reference : docs/ARCHITECTURE.md section 11. Les valeurs par defaut sont dans shared/config.ts.

# --- Mode global ---
# mock (defaut) : tout simule. testnet : comptes NEAR reels, IA reelle si NEARAI_API_KEY est renseignee.
DARWIN_MODE=mock
# Preset de simulation : normal | demo (demo = 3 generations en quelques minutes)
DARWIN_PRESET=normal
# Forcer un choix (optionnel) : DARWIN_CHAIN=mock|near ; DARWIN_BRAIN=mock|nearai
DARWIN_CHAIN=
DARWIN_BRAIN=
# Graine du hasard (meme graine = meme simulation en mock)
DARWIN_SEED=42

# --- Serveur ---
HOST=127.0.0.1
PORT=3000
DARWIN_DATA_DIR=data
# Jeton requis par les routes d'administration (pause/reprise/reset) si renseigne. SECRET.
DARWIN_ADMIN_TOKEN=
# Minimum 24 caracteres si renseigne (refus de demarrage sinon).
# Hotes supplementaires acceptes dans l'en-tete Host (protection contre le rebond DNS), separes par des virgules. Par defaut : localhost, 127.0.0.1, [::1] et HOST. Ex. : demo.example.org. "*" desactive le controle.
DARWIN_ALLOWED_HOSTS=
# Plafond de depense par heure du compte de demo des visiteurs, en NEAR (defaut selon preset/mode). Au-dela : HTTP 429.
DARWIN_VISITOR_HOURLY_CAP_NEAR=

# --- NEAR testnet (mode testnet uniquement) ---
NEAR_NETWORK=testnet
# URL RPC testnet publique (liste officielle : https://docs.near.org/api/rpc/providers)
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Compte maitre testnet : parent des sous-comptes des agents. Faucet : https://near-faucet.io
NEAR_MASTER_ACCOUNT_ID=
# SECRET : cle privee du compte maitre (format ed25519:...). Jamais commitee, jamais journalisee.
NEAR_MASTER_PRIVATE_KEY=
# Compte du contrat Darwin (registre + sequestre + reputation), rempli apres le deploiement
NEAR_CONTRACT_ID=

# --- NEAR AI Cloud (cerveau des agents) ---
# SECRET : cle API (cloud.near.ai > API Keys). Vide = cerveau mock.
NEARAI_API_KEY=
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
# Modele par defaut. Les modeles (gene) sont limites a une liste blanche bon marche (< 1 USD/M en entree, brain/model-list.ts) ; prix lus via GET /v1/model/list.
# Vide = le moins cher sans raisonnement.
NEARAI_MODEL=
NEARAI_TIMEOUT_MS=60000
# Plafonds GLOBAUX de depense IA reelle (USD) sur la cle de plateforme. Vide = valeurs par defaut du cerveau (2 USD par lancement, 1 USD par heure).
NEARAI_MAX_USD_PER_RUN=
NEARAI_MAX_USD_PER_HOUR=

# --- Budget IA reel (L11) ---
# Budget total prevu et plafond d'ARRET (EUR) : une fois le plafond atteint, tout appel IA est refuse (BUDGET_EXHAUSTED) et la
# simulation s'arrete proprement. Le cumul est persistant (DARWIN_DATA_DIR/ai-budget.json) : il survit aux redemarrages.
# Chaque appel facture est journalise dans DARWIN_DATA_DIR/ai-usage.jsonl (npm run ai:usage-report).
DARWIN_AI_BUDGET_EUR_TOTAL=10
DARWIN_AI_BUDGET_EUR_STOP=8
# USD pour 1 EUR. Defaut prudent 1.10 (cours observe le 2026-11-10 : 1.1214, source api.frankfurter.dev) : un taux plus bas
# surestime le cout en EUR, donc arrete plus tot.
DARWIN_EUR_USD_RATE=1.10

# --- Fournisseur OpenAI-compatible de secours (optionnel) ---
# Utilise si NEAR AI Cloud echoue de facon repetee (3 echecs consecutifs : panne, timeout, 429, 401/402/403) ou si NEARAI_API_KEY est vide.
# Les trois premieres variables sont requises ensemble. SECRET : AI_API_KEY. https obligatoire. Le plafond de budget s'applique aussi.
# Pas de liste blanche NEAR pour ce repli ; prix inconnus => valeurs pessimistes 1 / 5 USD par million de tokens si non renseignes.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_PRICE_IN_USD_PER_M=
AI_PRICE_OUT_USD_PER_M=

# --- Parametres de simulation (tous optionnels : surchargent le preset) ---
# Montants en NEAR (decimaux), durees en ticks.
DARWIN_TICK_MS=
DARWIN_FOUNDERS=
DARWIN_MAX_POPULATION=
DARWIN_MAX_TICKS=
DARWIN_BIRTH_CAPITAL=
DARWIN_METABOLISM=
DARWIN_MIN_VITAL=
DARWIN_REPRO_COOLDOWN_TICKS=
DARWIN_SIM_CLIENT_RATE=
DARWIN_TASK_BUDGET_MIN=
DARWIN_TASK_BUDGET_MAX=
DARWIN_BID_WINDOW_TICKS=
DARWIN_TASK_DEADLINE_TICKS=
DARWIN_MUTATION_RATE=
DARWIN_MUTATION_SD=
# USD pour 1 NEAR : taux de conversion des couts IA (parametre de la simulation, pas un cours de marche)
DARWIN_NEAR_USD_RATE=
DARWIN_MAX_TOKENS_PER_CALL=
DARWIN_SETTLE_EVERY_TICKS=

# --- NEAR Intents (demo mainnet, hors V1, desactive par defaut) ---
INTENTS_ENABLED=false
INTENTS_BASE_URL=https://1click.chaindefuser.com
# SECRET optionnel : JWT/cle 1Click (partners.near-intents.org)
INTENTS_JWT=
# true : seuls les devis dry:true sont permis. Passer a false exige un feu vert humain ecrit (docs/BESOINS_HUMAIN.md).
INTENTS_DRY_ONLY=true

# Testnet : numero de depart des identifiants d agents (comptes et registre du contrat persistent entre deux lancements)
DARWIN_AGENT_SEQ_START=
# Testnet : numero de depart des identifiants de taches (les sequestres du contrat persistent entre deux lancements)
DARWIN_TASK_SEQ_START=
