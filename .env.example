# Darwin - environment variables. NO secret value here. Copy to .env (git-ignored).
# With no .env at all: full mock mode (simulated chain + AI), no key needed.
# Reference: docs/ARCHITECTURE.md section 11. Default values live in shared/config.ts.

# --- Global mode ---
# mock (default): everything simulated. testnet: real NEAR accounts, real AI if NEARAI_API_KEY is set.
DARWIN_MODE=mock
# Simulation preset: normal | demo (demo = 3 generations in a few minutes)
DARWIN_PRESET=normal   # normal | demo | selection (testnet: deaths and generation 3 visible in a single run)
# Force a choice (optional): DARWIN_CHAIN=mock|near ; DARWIN_BRAIN=mock|nearai
DARWIN_CHAIN=
DARWIN_BRAIN=
# Random seed (same seed = same simulation in mock)
DARWIN_SEED=42

# --- Server ---
HOST=127.0.0.1
PORT=3000
DARWIN_DATA_DIR=data
# Token required by the admin routes (pause/resume/reset) if set. SECRET.
DARWIN_ADMIN_TOKEN=
# Minimum 24 characters if set (startup refused otherwise).
# Extra hosts accepted in the Host header (DNS rebinding protection), comma-separated. Default: localhost, 127.0.0.1, [::1] and HOST. E.g.: demo.example.org. "*" disables the check.
DARWIN_ALLOWED_HOSTS=
# Spending cap per hour of the visitors' demo account, in NEAR (default depends on preset/mode). Beyond it: HTTP 429.
DARWIN_VISITOR_HOURLY_CAP_NEAR=

# --- NEAR testnet (testnet mode only) ---
NEAR_NETWORK=testnet
# Public testnet RPC URL (official list: https://docs.near.org/api/rpc/providers)
# One or more providers separated by commas (automatic failover). Public, keyless, listed at
# https://docs.near.org/api/rpc/providers: https://test.rpc.fastnear.com, https://near-testnet.drpc.org,
# https://testnet-rpc.intea.rs, https://api.zan.top/near-testnet (limits not comparable, to be tested).
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Testnet master account: parent of the agents' sub-accounts. Faucet: https://near-faucet.io
NEAR_MASTER_ACCOUNT_ID=
# SECRET: private key of the master account (format ed25519:...). Never committed, never logged.
NEAR_MASTER_PRIVATE_KEY=
# Darwin contract account (registry + escrow + reputation), filled in after deployment
NEAR_CONTRACT_ID=

# --- NEAR AI Cloud (the agents' brain) ---
# SECRET: API key (cloud.near.ai > API Keys). Empty = mock brain.
NEARAI_API_KEY=
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
# Default model. Models (gene) are limited to a cheap allow-list (< 1 USD/M input, brain/model-list.ts); prices read via GET /v1/model/list.
# Empty = the cheapest one without reasoning.
NEARAI_MODEL=
NEARAI_TIMEOUT_MS=60000
# GLOBAL caps on real AI spending (USD) on the platform key. Empty = brain defaults (2 USD per run, 1 USD per hour).
NEARAI_MAX_USD_PER_RUN=
NEARAI_MAX_USD_PER_HOUR=

# --- Real AI budget (L11) ---
# Planned total budget and STOP cap (EUR): once the cap is reached, every AI call is refused (BUDGET_EXHAUSTED) and the
# simulation stops cleanly. The running total is persistent (DARWIN_DATA_DIR/ai-budget.json): it survives restarts.
# Every billed call is logged in DARWIN_DATA_DIR/ai-usage.jsonl (npm run ai:usage-report).
DARWIN_AI_BUDGET_EUR_TOTAL=10
DARWIN_AI_BUDGET_EUR_STOP=8
# USD for 1 EUR. Cautious default 1.10 (rate observed on 2026-11-10: 1.1214, source api.frankfurter.dev): a lower rate
# overestimates the cost in EUR, hence stops earlier.
DARWIN_EUR_USD_RATE=1.10

# --- Fallback OpenAI-compatible provider (optional) ---
# Used if NEAR AI Cloud fails repeatedly (3 consecutive failures: outage, timeout, 429, 401/402/403) or if NEARAI_API_KEY is empty.
# The first three variables are required together. SECRET: AI_API_KEY. https required. The budget cap applies here too.
# No NEAR allow-list for this fallback; unknown prices => pessimistic values 1 / 5 USD per million tokens if not set.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_PRICE_IN_USD_PER_M=
AI_PRICE_OUT_USD_PER_M=

# --- Simulation parameters (all optional: override the preset) ---
# Amounts in NEAR (decimals), durations in ticks.
DARWIN_TICK_MS=
DARWIN_FOUNDERS=
DARWIN_MAX_POPULATION=
DARWIN_MAX_TICKS=
DARWIN_BIRTH_CAPITAL=
DARWIN_METABOLISM=
DARWIN_MIN_VITAL=
DARWIN_REPRO_COOLDOWN_TICKS=
DARWIN_SIM_CLIENT_RATE=
DARWIN_TASK_BUDGET_MIN=
DARWIN_TASK_BUDGET_MAX=
DARWIN_BID_WINDOW_TICKS=
DARWIN_TASK_DEADLINE_TICKS=
DARWIN_MUTATION_RATE=
DARWIN_MUTATION_SD=
# USD for 1 NEAR: conversion rate for AI costs (a simulation parameter, not a market rate)
DARWIN_NEAR_USD_RATE=
DARWIN_MAX_TOKENS_PER_CALL=
DARWIN_SETTLE_EVERY_TICKS=

# --- NEAR Intents (mainnet demo, outside V1, disabled by default) ---
INTENTS_ENABLED=false
INTENTS_BASE_URL=https://1click.chaindefuser.com
# Optional SECRET: 1Click JWT/key (partners.near-intents.org)
INTENTS_JWT=
# true: only dry:true quotes are allowed. Switching to false requires a written human green light (docs/BESOINS_HUMAIN.md).
INTENTS_DRY_ONLY=true

# Testnet: AUTOMATIC offset (clock) if empty. Starting number of agent identifiers (accounts and contract registry persist between two launches)
DARWIN_AGENT_SEQ_START=
# Testnet: AUTOMATIC offset if empty. Starting number of task identifiers (contract escrows persist between two launches)
DARWIN_TASK_SEQ_START=

# --- Additional simulation parameters (optional) ---
# Catalogue price scale (decimal number, default: the preset's)
DARWIN_PRICE_SCALE=
# VISITOR tasks: bidding window length and deadline, in ticks (default: the preset's)
DARWIN_VISITOR_BID_WINDOW_TICKS=
DARWIN_VISITOR_TASK_DEADLINE_TICKS=

# --- Replay mode (`npm run replay`): replays a real-run journal, no key, no NEAR network, no AI call (all optional) ---
# JSONL journal to replay (default: docs/preuves/run8-journal.jsonl; 20 MB maximum)
DARWIN_REPLAY_FILE=
# Playback speed, 0.25 to 100 (default: 5)
DARWIN_REPLAY_SPEED=
# 1: restart after a pause at the end of the journal
DARWIN_REPLAY_LOOP=
# Maximum silence kept between two events, in ms (default: 8000)
DARWIN_REPLAY_MAX_GAP_MS=
# Label shown in the replay banner (200 characters maximum)
DARWIN_REPLAY_LABEL=
# Replay control (speed, pause, restart): empty = open to any visitor (local use).
# "locked" for any public demo: requires DARWIN_ADMIN_TOKEN (24 characters or more), otherwise startup is refused.
DARWIN_REPLAY_CONTROL=
